# Sao chép file này thành ".env" (KHÔNG commit file .env thật lên Git) rồi điền giá trị thật.

# BẮT BUỘC ở production, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Tên miền thật của website (dùng cho sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://ten-mien-cua-ban.com

# Gửi email (quên mật khẩu admin, xác nhận đơn hàng)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
