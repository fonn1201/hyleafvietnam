# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (SQLite dev.db chứa dữ liệu thật - KHÔNG commit lên repo, đặc
# biệt nguy hiểm với repo public vì lộ mật khẩu admin đã băm, email, dữ
# liệu sản phẩm/tin tức thật)
/prisma/*.db
/prisma/*.db-journal
*.sqlite
*.sqlite3
